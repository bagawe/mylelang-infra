# ---------------------------------------------------------------------------
# My Lelang - dev environment config (single shared file).
#
# Copy to env/dev.env on the VPS and fill in real values. env/dev.env is
# gitignored and must NEVER be committed. This file is both:
#   - the --env-file for Compose variable interpolation (${VAR})
#   - the env_file passed to the api / worker / web / migrate / seed services
#
# NOTE: env files are literal KEY=VALUE with NO ${} expansion. If you change
# POSTGRES_* you MUST update DATABASE_URL by hand to match.
# ---------------------------------------------------------------------------

# --- Domains / TLS (Caddy) -------------------------------------------------
APP_DOMAIN=dev.mylelang.id
API_DOMAIN=api.dev.mylelang.id
CADDY_EMAIL=admin@mylelang.id

# --- Web: public (BAKED into the image at build time) ----------------------
NEXT_PUBLIC_APP_URL=https://dev.mylelang.id
# Browser calls the Next.js BFF on the same origin (/api/v1/* → backend).
NEXT_PUBLIC_API_BASE_URL=https://dev.mylelang.id/api/v1
# WebSocket goes straight to the Nest API host.
NEXT_PUBLIC_WS_URL=https://api.dev.mylelang.id
NEXT_PUBLIC_SENTRY_DSN=

# --- Web: server-only (runtime) --------------------------------------------
# API_BASE_URL is the in-cluster address the BFF uses to reach the API.
API_BASE_URL=http://api:3000/api/v1
SESSION_COOKIE_NAME=mylelang_session
# Real service key: after first deploy, mint with service-client (see README §G)
API_KEY=mlk_00000000000000000000000000000000_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# --- API / Worker ----------------------------------------------------------
PORT=3000
LOG_LEVEL=info
# Allowed browser origins for CORS (comma-separated). Usually just the web app.
CORS_ORIGINS=https://dev.mylelang.id

# Postgres (keep the three values below in sync with DATABASE_URL)
POSTGRES_USER=mylelang
POSTGRES_PASSWORD=change-me-postgres-strong
POSTGRES_DB=mylelang
DATABASE_URL=postgresql://mylelang:change-me-postgres-strong@postgres:5432/mylelang?schema=public

REDIS_URL=redis://redis:6379

# Object storage (MinIO). ACCESS/SECRET also seed the MinIO root credentials.
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=mylelang-uploads
OBJECT_STORAGE_ACCESS_KEY=mylelang-minio
OBJECT_STORAGE_SECRET_KEY=change-me-minio-strong

# Virus scanner (ClamAV). Inside Compose use service hostname + internal port.
# First boot can take several minutes while signature DB loads.
CLAMD_HOST=clamav
CLAMD_PORT=3310

# Email: fake = no real delivery (dev). For real email set EMAIL_PROVIDER=resend
# and fill the two keys below (and consider NODE_ENV=production in compose).
EMAIL_PROVIDER=fake
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Encryption keys (REQUIRED) --------------------------------------------
# Generate each separately: openssl rand -hex 32
# Losing these makes existing encrypted data unreadable. Back them up securely.
ACTIVATION_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
MFA_ENCRYPTION_KEY=replace-with-another-64-hex-characters
IDENTITY_ENCRYPTION_KEY=replace-with-third-64-hex-characters
BANK_ACCOUNT_ENCRYPTION_KEY=replace-with-fourth-64-hex-characters
